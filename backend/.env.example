PORT=3000
NODE_ENV=development

# Banco de dados. Em desenvolvimento use um banco LOCAL, nunca o de produção.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=amanda_cosmeticos
DB_CONNECTION_LIMIT=10

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Em produção a API não inicia com menos de 32 caracteres ou com o valor de exemplo.
JWT_SECRET=troque-por-um-segredo-forte
ADMIN_JWT_EXPIRES_IN=8h

# Administrador inicial. Depois que a conta existir, REMOVA ADMIN_PASSWORD do ambiente.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Só use "true" para reativar/redefinir a conta acima; remova logo depois.
ADMIN_BOOTSTRAP_RESET=

GOOGLE_CLIENT_ID=
PIX_KEY=

# Origens autorizadas no CORS, separadas por vírgula (sem barra no final).
FRONTEND_URL=http://localhost:5173
# Produção:
# FRONTEND_URL=https://www.amandacosmeticos.com.br,https://amandacosmeticos.com.br

# Fuso da loja para relatórios (Brasil sem horário de verão: -03:00).
STORE_UTC_OFFSET=-03:00

# Proxies confiáveis à frente da API (Hostinger: 1). Padrão: 1 em produção, desligado em desenvolvimento.
TRUST_PROXY=

# Limites por IP a cada 15 minutos (opcionais).
RATE_LIMIT_ADMIN_LOGIN=10
RATE_LIMIT_ADMIN=600
RATE_LIMIT_PUBLIC_SENSITIVE=30
RATE_LIMIT_API=1000
