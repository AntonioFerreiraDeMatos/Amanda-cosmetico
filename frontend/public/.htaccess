RewriteEngine On
RewriteCond %{HTTP_HOST} ^amandacosmeticos\.com\.br$ [NC]
RewriteRule ^ https://www.amandacosmeticos.com.br%{REQUEST_URI} [R=301,L]

# HTML sempre revalidado, para o navegador pegar a versão nova após cada publicação.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Arquivos em /assets têm hash no nome; podem ficar em cache por 1 ano.
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|jfif|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
